# ==============================================================================
# Advanced Java Laboratory Record - Server Security & Production Hardening
# ==============================================================================

# 1. Disable Directory Browsing / Indexing (Crucial: prevents viewing raw folder trees)
Options -Indexes

# 2. Prevent Access to Hidden / Sensitive Files (.git, .env, .DS_Store, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# 3. Security Headers
<IfModule mod_headers.c>
    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Prevent clickjacking / framing
    Header always set X-Frame-Options "SAMEORIGIN"

    # Strict Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Restrict unnecessary browser features
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Cross-Origin Isolation & Resource Policy
    Header always set Cross-Origin-Resource-Policy "same-origin"

    # Cross-Site Scripting Protection filter
    Header always set X-XSS-Protection "1; mode=block"

    # Strict Content Security Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self';"
</IfModule>

# 4. Standard MIME Types
<IfModule mod_mime.c>
    AddType application/json .json
    AddType application/javascript .js
    AddType text/css .css
    AddType application/pdf .pdf
    AddType image/svg+xml .svg
    AddType image/jpeg .jpeg .jpg
    AddType image/png .png
    AddType font/woff2 .woff2
</IfModule>

# 5. Enable Gzip Compression for Fast Loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
